@model DziennikSzkolnyMVC.ViewModels.ManageClassStudentsViewModel

@{
    ViewData["Title"] = $"Zarządzanie uczniami - {Model.ClassName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Zarządzanie uczniami w klasie @Model.ClassName (@Model.SchoolYear)</h2>
    <a asp-action="Index" class="btn btn-secondary">Powrót do listy klas</a>
</div>

<div class="row">
    <div class="col-md-5 mb-4">
        <h5 class="mb-0">Przypisz ucznia do klasy</h5>
        @if (!Model.AvailableStudents.Any())
        {
            <div class="alert alert-info mb-0">
                Brak nieprzypisanych uczniów w systemie. Zarejestruj nowe konta z rolą Uczeń.
            </div>
        }
        else
        {
            <form asp-action="AddStudentToClass" method="post">
                <input type="hidden" name="classId" value="@Model.ClassId" />
                <div class="form-group mb-3">
                    <label class="form-label">Wybierz ucznia z listy:</label>
                    <select name="studentId" class="form-select" asp-items="Model.AvailableStudents">
                        <option value="">-- Wybierz ucznia --</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-success w-100">Dodaj do klasy</button>
            </form>
        }
    </div>
    
    <div class="col-md-7">
        <h5 class="mb-0">Uczniowie w tej klasie (@Model.AssignedStudents.Count)</h5>
        @if (!Model.AssignedStudents.Any())
        {
            <p class="p-3 text-muted mb-0">Ta klasa nie ma jeszcze żadnych przypisanych uczniów.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                <tr>
                    <th>Imię i nazwisko</th>
                    <th>Email</th>
                    <th class="text-end">Akcja</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var student in Model.AssignedStudents)
                {
                    <tr>
                        <td>@student.FirstName @student.LastName</td>
                        <td>@student.Email</td>
                        <td class="text-end">
                            <form asp-action="RemoveStudentFromClass" method="post" class="d-inline">
                                <input type="hidden" name="classId" value="@Model.ClassId" />
                                <input type="hidden" name="studentId" value="@student.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" 
                                        onclick="return confirm('Czy na pewno chcesz usunąć tego ucznia z klasy?');">
                                    Wypisz
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>